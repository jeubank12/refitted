{
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(./gradlew tasks:*)",
      "Bash(./gradlew :app:assembleDebugAndroidTest:*)",
      "Bash(./gradlew projects:*)",
      "Bash(./gradlew:*)",
      "Bash(git ls-tree *)",
      "Bash(npx tsc *)",
      "Bash(xargs cat:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
